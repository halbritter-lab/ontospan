{
  "$defs": {
    "Contributor": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "orcid": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Orcid"
        }
      },
      "required": [
        "actor_id"
      ],
      "title": "Contributor",
      "type": "object"
    },
    "FileEntry": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "FileEntry",
      "type": "object"
    },
    "Layer": {
      "additionalProperties": false,
      "properties": {
        "allowed_roots": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Roots",
          "type": "array"
        },
        "layer_id": {
          "minLength": 1,
          "title": "Layer Id",
          "type": "string"
        },
        "ontology": {
          "$ref": "#/$defs/OntologyResource"
        },
        "profile": {
          "minLength": 1,
          "title": "Profile",
          "type": "string"
        }
      },
      "required": [
        "layer_id",
        "profile",
        "ontology"
      ],
      "title": "Layer",
      "type": "object"
    },
    "OntologyResource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "iri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Iri"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "OntologyResource",
      "type": "object"
    },
    "Producer": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "Producer",
      "type": "object"
    },
    "ReleaseInfo": {
      "additionalProperties": false,
      "description": "Release metadata of a bundle (format 1.1).",
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "producer": {
          "anyOf": [
            {
              "$ref": "#/$defs/Producer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "supersedes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SupersededRelease"
          },
          "title": "Supersedes",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "ReleaseInfo",
      "type": "object"
    },
    "SupersededRelease": {
      "additionalProperties": false,
      "properties": {
        "bundle_id": {
          "minLength": 1,
          "title": "Bundle Id",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        }
      },
      "required": [
        "bundle_id",
        "manifest_sha256"
      ],
      "title": "SupersededRelease",
      "type": "object"
    }
  },
  "$id": "urn:ontospan:schema:bundle-manifest-1.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type": {
      "const": "bundle",
      "default": "bundle",
      "title": "Artifact Type",
      "type": "string"
    },
    "bundle_id": {
      "minLength": 1,
      "title": "Bundle Id",
      "type": "string"
    },
    "contributors": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Contributor"
      },
      "title": "Contributors",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/FileEntry"
      },
      "minItems": 1,
      "title": "Files",
      "type": "array"
    },
    "layers": {
      "items": {
        "$ref": "#/$defs/Layer"
      },
      "minItems": 1,
      "title": "Layers",
      "type": "array"
    },
    "release": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReleaseInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "release_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Release Name"
    },
    "schema_version": {
      "default": "1.1.0",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "bundle_id",
    "created_at",
    "layers",
    "files"
  ],
  "title": "Manifest",
  "type": "object"
}
